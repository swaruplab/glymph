#!/bin/bash
# h3pull <path on HPC3, as rsync source> <local destination> [extra rsync options for the HPC3 leg]
# HPC3 transfer node -> Studio scratch -> MacBook. Small tables only.
src="$1"; dst="$2"; shift 2
key=$(printf '%s' "$src" | /sbin/md5 | cut -c1-12)
rel="LocalDocuments/compute/glymph_relay/pull_$key"
opts=""; [ $# -gt 0 ] && opts=$(printf ' %q' "$@")
ssh -o BatchMode=yes -o ConnectTimeout=15 studio-work "mkdir -p $rel && /opt/homebrew/bin/rsync -a --timeout=120 $opts hpc3-xfer:$src $rel/" || exit 1
rsync -a --timeout=120 --rsync-path=/opt/homebrew/bin/rsync "studio-work:$rel/" "$dst"
